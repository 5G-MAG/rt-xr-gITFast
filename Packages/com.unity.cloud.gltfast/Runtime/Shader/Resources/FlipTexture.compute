#pragma kernel CSMain

// the picture, or the luma plane of a planar YCbCr format
Texture2D<float4> texSrc;
// the chroma planes of a planar YCbCr format, at half the width and height: Cb and Cr, or Cb and Cr interleaved in texCb
Texture2D<float4> texCb;
Texture2D<float4> texCr;
RWTexture2D<float4> texOut;

int height;
int width;
// 0 pass through, 1 swap red and blue, 2 red only, 3 green only, 4 blue only, 5 red and green, 6 one component as grey,
// 7 YCbCr in three planes, 8 YCbCr in two planes
int mode;
// brightness factor of the picture (an app setting, not part of the specification)
float gain;

// MPEG_sampler_YCbCr (the Vulkan YCbCr conversion): 0 RGB_IDENTITY, 1 YCBCR_IDENTITY, otherwise a colour model with the
// luma coefficients kr and kb
int ycbcrModel;
int ycbcrNarrow;
float kr;
float kb;

float3 YCbCrToRGB(float y, float cb, float cr)
{
    // the planes of the G8_B8_R8 formats hold G (Y), B (Cb) and R (Cr)
    if (ycbcrModel == 0)
    {
        return float3(cr, y, cb);
    }
    // range expansion of 8 bit samples
    if (ycbcrNarrow != 0)
    {
        y = (y * 255.0 - 16.0) / 219.0;
        cb = (cb * 255.0 - 128.0) / 224.0;
        cr = (cr * 255.0 - 128.0) / 224.0;
    }
    else
    {
        cb -= 128.0 / 255.0;
        cr -= 128.0 / 255.0;
    }
    if (ycbcrModel == 1)
    {
        return float3(cr, y, cb);
    }
    float kg = 1.0 - kr - kb;
    float r = y + 2.0 * (1.0 - kr) * cr;
    float b = y + 2.0 * (1.0 - kb) * cb;
    float g = y - (2.0 * kr * (1.0 - kr) / kg) * cr - (2.0 * kb * (1.0 - kb) / kg) * cb;
    return float3(r, g, b);
}

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)width || id.y >= (uint)height)
    {
        return;
    }
    int2 coords = int2(id.x, height - 1 - id.y);
    float4 c = texSrc[coords];
    if (mode == 1)
    {
        c = float4(c.b, c.g, c.r, c.a);
    }
    else if (mode == 2)
    {
        c = float4(c.r, 0, 0, 1);
    }
    else if (mode == 3)
    {
        c = float4(0, c.r, 0, 1);
    }
    else if (mode == 4)
    {
        c = float4(0, 0, c.r, 1);
    }
    else if (mode == 5)
    {
        c = float4(c.r, c.g, 0, 1);
    }
    else if (mode == 6)
    {
        c = float4(c.r, c.r, c.r, 1);
    }
    else if (mode == 7 || mode == 8)
    {
        // nearest chroma sample, cosited with the even luma samples
        int2 chroma = coords / 2;
        float cb = texCb[chroma].r;
        float cr = mode == 7 ? texCr[chroma].r : texCb[chroma].g;
        c = float4(YCbCrToRGB(c.r, cb, cr), 1);
    }
    c.rgb = saturate(c.rgb * gain);
    texOut[id.xy] = c;
}
